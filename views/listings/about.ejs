<% layout("/layouts/boilerplate") %>

<div class="container mt-2">
  <div class="text-center mb-4">
    <h2 class="fw-bold">About Us</h2>
    <p class="text-muted">Know more about Travel Stay</p>
  </div>

  <div class="row align-items-center">
    
    <!-- Left Side (Image) -->
    <div class="col-md-6 mb-3">
      <img src="/images/about.png" class="img-fluid rounded shadow" alt="About Us">
    </div>

    <!-- Right Side (Content) -->
    <div class="col-md-6">
      <h4 class="fw-semibold mb-3">Welcome to Travel Stay ✈️</h4>
      
      <p>
        Travel Stay is a modern platform designed to help users discover, explore, 
        and book unique stays across different destinations. Our goal is to make 
        travel simple, secure, and enjoyable for everyone.
      </p>

      <p>
        Whether you're planning a short trip or a long vacation, we provide the best 
        listings with easy booking and reliable service.
      </p>

      <a href="/listings" class="btn btn-dark mt-2 px-4">Explore Listings</a>
    </div>

  </div>
</div>