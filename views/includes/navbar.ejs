<style>
    .search-btn{
        background-color: #fe424d;
        color: #fff;
    }
    .search-btn:hover{
        background-color: #fe424d;
        color: #fff;
    }
    .search-btn i{
        display: inline;
        
    }
    .search-inp{
        border-radius: 25px;
        padding: 0.5rem 3rem 0.5rem 3rem;
    }
</style>


<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="/listings">
            <div class="logo-wrapper">
                <img src="/images/newLogo.png" alt="TravelStay Logo" class="logo">
            </div>
            <span class="ms-2 fw-bold"></span>
        </a>

        <!-- Toggle button (important for mobile) -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
                <a class="nav-link" href="/listings">Home</a>
                <a class="nav-link" href="/listings/new">Add New Listing</a>
                
            </div>

                    

            <div class="navbar-nav ms-auto">
                <form class="d-flex" role="search" action="/listings/search" method="GET"
                    class="d-flex align-items-center px-2 py-1 rounded-pill shadow-sm border border-dark">

                     <input type="text" name="location" class="search-inp form-control  me-2 "aria-label="Search"
                        placeholder="Search..." style="box-shadow: none;" required>

                    <button type="submit"
                        class="btn search-btn rounded-circle ms-2 d-flex justify-content-center align-items-center"
                        style="border-color: #fe424d; width: 35px; height: 35px;">

                        <i class="fa-solid fa-magnifying-glass text-white"></i>

                    </button>
                </form>
            </div>

            <div class="navbar-nav ms-auto">
                <a class="nav-link me-3" href="/listings/about">Abount Us</a>
                <% if (currUser && currUser.isAdmin) { %>
                    <a href="/admin/dashboard" class="btn btn-light me-3">Admin Panel</a>
                    <% } %>
                        <% if(!currUser){ %>
                            <a class="btn btn-light me-3 " href="/login">Log in</a>
                            <a class="btn btn-primary rounded-pill px-3 py-2 fw-semibold btn-sm" type="button"
                                href="/signup">Sign Up</a>
                            <% } %>
                                <% if(currUser){ %>
                                    <a class="btn btn-danger rounded-pill px-3 py-2 fw-semibold btn-sm" type="button"
                                        href="/logout">Log out</a>
                                    <% } %>
            </div>
        </div>
    </div>
</nav>